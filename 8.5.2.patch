+++ b/src/apollo/client.ts
@@ -0,0 +1,12 @@
+import { ApolloClient, HttpLink, InMemoryCache } from "@apollo/client";
+
+export const apolloClient = new ApolloClient({
+  link: new HttpLink({
+    uri: "/graphql",
+  }),
+  cache: new InMemoryCache(),
+});
+
+export default apolloClient;
