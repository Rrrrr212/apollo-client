diff --git a/src/components/UserAvatar.tsx b/src/components/UserAvatar.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/UserAvatar.tsx
@@ -0,0 +1,33 @@
+import { useQuery } from "@apollo/client/react";
+import { GET_CURRENT_USER_QUERY } from "../graphql/queries/user";
+
+type CurrentUserQueryData = {
+  currentUser: {
+    id: string;
+    name: string;
+    avatarUrl: string | null;
+  } | null;
+};
+
+export function UserAvatar() {
+  const { data, loading, error } = useQuery<CurrentUserQueryData>(
+    GET_CURRENT_USER_QUERY,
+    {
+      fetchPolicy: "cache-first",
+    }
+  );
+
+  if (loading) {
+    return <span>Loading...</span>;
+  }
+
+  if (error || !data?.currentUser) {
+    return <span>User</span>;
+  }
+
+  const { name, avatarUrl } = data.currentUser;
+
+  if (!avatarUrl) {
+    return <span>{name.charAt(0).toUpperCase()}</span>;
+  }
+
+  return <img src={avatarUrl} alt={name} />;
+}
+
+export default UserAvatar;
diff --git a/src/graphql/queries/user.ts b/src/graphql/queries/user.ts
new file mode 100644
