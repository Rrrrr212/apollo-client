+++ b/src/graphql/queries/user.ts
@@ -0,0 +1,11 @@
+import { gql } from "@apollo/client";
+
+export const GET_CURRENT_USER_QUERY = gql`
+  query GetCurrentUser {
+    currentUser {
+      id
+      name
+      avatarUrl
+    }
+  }
+`;
diff --git a/src/apollo/client.ts b/src/apollo/client.ts
new file mode 100644
