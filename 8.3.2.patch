diff --git a/src/components/TodoList.tsx b/src/components/TodoList.tsx
--- a/src/components/TodoList.tsx
+++ b/src/components/TodoList.tsx
@@
-const { data, loading, error } = useQuery(GET_TODOS_QUERY);
+const { data, loading, error } = useQuery(GET_TODOS_QUERY, {
+  fetchPolicy: "cache-first",
+  nextFetchPolicy: "cache-only",
+});

diff --git a/src/mutations/completeTodo.ts b/src/mutations/completeTodo.ts
--- a/src/mutations/completeTodo.ts
+++ b/src/mutations/completeTodo.ts
@@
-const [completeTodoMutation, result] = useMutation(COMPLETE_TODO_MUTATION);
+const [completeTodoMutation, result] = useMutation(COMPLETE_TODO_MUTATION);

 const completeTodo = (id: string) =>
   completeTodoMutation({
     variables: { id },
+    update(cache, { data }) {
+      const completedTodo = data?.completeTodo;
+
+      if (!completedTodo?.id) {
+        return;
+      }
+
+      const cacheId = cache.identify(completedTodo);
+
+      if (!cacheId) {
+        return;
+      }
+
+      cache.modify({
+        id: cacheId,
+        fields: {
+          completed() {
+            return completedTodo.completed;
+          },
+        },
+      });
+    },
   });
