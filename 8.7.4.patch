diff --git a/.github/workflows/types-check.yml b/.github/workflows/types-check.yml
new file mode 100644
index 000000000..c90d85eb4
--- /dev/null
+++ b/.github/workflows/types-check.yml
@@ -0,0 +1,41 @@
+name: GraphQL Types Check
+
+on:
+  pull_request:
+    branches:
+      - main
+      - release-*
+
+concurrency: ${{ github.workflow }}-${{ github.ref }}
+
+permissions:
+  contents: read
+
+jobs:
+  types-check:
+    name: Check GraphQL type generation
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repo
+        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6
+        with:
+          persist-credentials: false
+
+      - name: Setup Node.js
+        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
+        with:
+          node-version: ">=23.6.0"
+
+      - run: npm ci
+
+      - name: Generate GraphQL types
+        run: npm run gen:types
+
+      - name: Check for uncommitted changes
+        run: |
+          if [ -n "$(git diff --exit-code -- src/graphql/generated.ts)" ]; then
+            echo "❌ Generated types are out of date. Please run 'npm run gen:types' and commit the result."
+            git diff -- src/graphql/generated.ts
+            exit 1
+          fi
+          echo "✅ Generated types are up to date."
